{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barbph.com/lineaige/event.schema.json",
  "title": "LINEAiGE Event Record",
  "description": "Portable canonical record format for LINEAiGE. The record is authoritative; interfaces are representations of it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","recordType","title","displayDate","temporalState","status","summary","verification","sources","relationships"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "recordType": {"type":"string","enum":["event","entry_point","living_edge","announced_future"]},
    "title": {"type":"string","minLength":1},
    "displayDate": {"type":"string","minLength":1},
    "eventDate": {"type":["string","null"],"format":"date"},
    "endDate": {"type":["string","null"],"format":"date"},
    "announcementDate": {"type":["string","null"],"format":"date"},
    "targetDate": {"type":["string","null"],"format":"date"},
    "temporalState": {"type":"string","enum":["recorded","forming","declared-unresolved"]},
    "status": {"type":"string","minLength":1},
    "summary": {"type":"string","minLength":1},
    "significance": {"type":["string","null"]},
    "people": {"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]},
    "organizations": {"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]},
    "technologies": {"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]},
    "geography": {
      "type":["object","null"],
      "additionalProperties":false,
      "properties": {
        "country":{"type":["string","null"],"minLength":1},
        "region":{"type":["string","null"],"enum":["Africa","Asia","Europe","Latin America and the Caribbean","Middle East","North America","Oceania",null]},
        "context":{"type":["string","null"],"enum":["organization-base","research-location","announcement-location","deployment-location","multi-region",null]},
        "note":{"type":["string","null"]},
        "sourceUrl":{"type":["string","null"],"format":"uri"}
      }
    },
    "verification": {
      "type":"object","additionalProperties":false,"required":["state","factualClaim"],
      "properties": {
        "state":{"type":"string","enum":["unreviewed","developing","verified","disputed","navigation-only"]},
        "factualClaim":{"type":"boolean"},
        "confidence":{"type":["string","null"],"enum":["low","medium","high",null]},
        "note":{"type":["string","null"]},
        "lastVerified":{"type":["string","null"],"format":"date-time"}
      }
    },
    "sources": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,"required":["title","url","sourceType","primary"],
        "properties": {
          "title":{"type":"string","minLength":1},
          "url":{"type":"string","format":"uri"},
          "embedUrl":{"type":["string","null"],"format":"uri"},
          "publisher":{"type":["string","null"]},
          "publishedDate":{"type":["string","null"],"format":"date"},
          "sourceType":{"type":"string","enum":["paper","official-announcement","archive","government-record","book","interview","video","news","other"]},
          "sourceRole":{"type":["string","null"],"enum":["claim-evidence","corroboration","archive-copy","context","relationship-evidence",null]},
          "primary":{"type":"boolean"},
          "archivedUrl":{"type":["string","null"],"format":"uri"}
        }
      }
    },
    "relationships": {
      "type":"array",
      "items": {
        "type":"object","additionalProperties":false,"required":["type","label","evidenceState"],
        "properties": {
          "type":{"type":"string","enum":["ancestor","descendant","influenced","enabled","contextual","chronological","related","source-path","navigation"]},
          "targetId":{"type":["string","null"]},
          "label":{"type":"string","minLength":1},
          "evidenceState":{"type":"string","enum":["verified","contextual","disputed","navigation-only"]},
          "evidenceNote":{"type":["string","null"]},
          "sourceUrls":{"type":"array","items":{"type":"string","format":"uri"},"uniqueItems":true,"default":[]}
        }
      }
    },
    "corrections": {
      "type":"array",
      "items": {"type":"object","additionalProperties":false,"required":["date","note"],"properties":{"date":{"type":"string","format":"date"},"note":{"type":"string","minLength":1},"previousValue":{"type":["string","null"]},"sourceUrl":{"type":["string","null"],"format":"uri"}}},
      "default":[]
    },
    "contributor": {
      "type":["object","null"],"additionalProperties":false,
      "properties":{"name":{"type":["string","null"]},"creditPreference":{"type":["string","null"]},"submittedAt":{"type":["string","null"],"format":"date-time"}}
    }
  }
}
